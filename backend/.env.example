# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# Local Docker Compose default:
# DATABASE_URL=postgresql://ejfinance_user:ejfinance_pass@db:5432/ejfinance_db
#
# Supabase (production): use the connection pooler, not the direct connection.
# Find this under Project Settings -> Database -> Connection string -> "Transaction" pooler.
# Port 6543 = pgbouncer transaction-mode pooler (use this for the deployed app).
# Port 5432 = direct connection (fine for one-off local scripts, not for the app).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# JSON array of allowed frontend origins.
CORS_ORIGINS=["http://localhost:3000"]

# --- App ---
DEBUG=False

# --- Azure Blob Storage (optional, for receipt uploads) ---
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=receipts
